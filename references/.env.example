# 复制到 ~/.config/seo-ops/.env 后填值(不要留在包内 —— 那里会被 skill 更新覆盖):
#   mkdir -p ~/.config/seo-ops && cp references/.env.example ~/.config/seo-ops/.env
# 已 export 的环境变量优先于本文件。

# C4 CWV:Chrome UX Report API key(申请步骤见 references/checklist/references/C4.md)
CRUX_API_KEY=

# C5 IndexNow:site_id:key 逗号分隔,如 tigerless-com:8f3a1c9e,tigerless-ai:d41d8cd9
# key 由各站工程师生成并挂在站根 {key}.txt;未登记则 C5 记 N.A.
INDEXNOW_KEYS=
