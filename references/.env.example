# Copy to ~/.config/seo-ops/.env, then fill in the values (don't leave it inside the package — skill updates overwrite it there):
#   mkdir -p ~/.config/seo-ops && cp references/.env.example ~/.config/seo-ops/.env
# Exported environment variables take precedence over this file.

# C4 CWV: Chrome UX Report API key (application steps in references/checklist/references/C4.md)
CRUX_API_KEY=

# C5 IndexNow: comma-separated site_id:key pairs, e.g. example-com:8f3a1c9e,example-org:d41d8cd9
# Each site's engineer generates the key and serves it at the site root as {key}.txt; C5 records N.A. if unregistered
INDEXNOW_KEYS=
